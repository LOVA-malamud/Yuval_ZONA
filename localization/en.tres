[&"", &"RALLY_TOOLTIP"]: [&"For 8 seconds, nearby allied troops move 15%% faster and attack 20%% faster. Radius: 300. Cooldown: 30 seconds."],
[&"", &"REGROUP_TOOLTIP"]: [&"Nearby troops regroup around your current position for up to 8 seconds, then resume their original lanes. Combat takes priority."],
[&"", &"RECRUIT_LOCATION"]: [&"New recruits spawn at your King and march %s. Existing armies keep their lanes."],
[&"", &"RALLYING_COUNT"]: [&"%d troops rallying"],
[&"", &"DIFFICULTY_EASY"]: [&"Next match: Easy"],
