[&"", &"SETTINGS_SAVED"]: [&"Settings saved."],
[&"", &"SETTINGS_SAVE_FAILED"]: [&"Changes apply for this session, but could not be saved."],
[&"", &"SETTINGS_RESET"]: [&"Default settings restored."],
