[&"", &"WORKER_RECRUIT_TOOLTIP"]: [&"Workers gather automatically and deliver wood and gold to your King."],
[&"", &"NOT_ENOUGH_RESOURCES"]: [&"Not enough resources."],
[&"", &"HELP_BUTTON"]: [&"How to play"],
[&"", &"HELP_DISMISS"]: [&"Hide tips"],
[&"", &"HELP_GUIDANCE"]: [&"FIRST MATCH"],
[&"", &"HELP_TITLE"]: [&"How to play"],
[&"", &"HELP_OBJECTIVE"]: [&"Protect your King. Destroy the enemy King to win. Your ally shares your resources and your crown."],
[&"", &"HELP_PAGE"]: [&"%d / %d"],
[&"", &"HELP_PREVIOUS"]: [&"Previous"],
[&"", &"HELP_NEXT"]: [&"Next"],
[&"", &"HELP_CLOSE"]: [&"Close guide"],
[&"", &"HELP_CONTROLS_TITLE"]: [&"You are a commander"],
[&"", &"HELP_CONTROLS_BODY"]: [&"WASD moves; hold Space to attack. Shift dashes without invulnerability. F guards your front briefly. C commits a narrow heavy strike: a difficult hit deals damage and stuns briefly; dodging leaves its attacker open.\nE near your King begins gradual recovery. Moving, attacking or taking damage interrupts it and the cooldown remains."],
[&"", &"HELP_CONTROLS_BODY_TOUCH"]: [&"Drag left to move. Nearby enemies are attacked automatically even without holding movement. Drag an action button to aim and release to commit; return to the button to cancel. Dash dodges, guard protects your front, and the difficult heavy strike briefly stuns on a hit.\nInteract near your King begins gradual healing; movement, attack or damage interrupts it. Army / orders opens the economy drawer without pausing."],
[&"", &"HELP_CONTROLS_ACTION"]: [&"Start by moving out from your base. Your commander has a white ring and a YOU marker."],
[&"", &"HELP_CONTROLS_ACTION_TOUCH"]: [&"Drag from the left side to leave your base. Your commander has a white ring and a YOU marker."],
[&"", &"HELP_ARMY_TITLE"]: [&"Recruit and choose a route"],
[&"", &"HELP_ARMY_BODY"]: [&"Spend gold in the Army tab to recruit. Choose North, Center or South first: new troops march along that route automatically. Existing troops keep their route.\nMelee holds the frontline. Ranged attacks from behind it. Tanks lead assaults on towers and Kings. You can recruit while away from your base."],
[&"", &"HELP_ARMY_ACTION"]: [&"Choose a route, recruit a few different units, then join their advance."],
[&"", &"HELP_RESOURCES_TITLE"]: [&"Gold, wood and workers"],
[&"", &"HELP_RESOURCES_BODY"]: [&"Gold arrives steadily and pays for recruits. Workers gather wood, carry it home and deliver both wood and gold. Wood pays for upgrades; towers cost both resources.\nYour ally uses the same wallet and leaves a reserve for you. Workers work automatically, seek new trees and retreat from nearby enemies. Forward groves are valuable but exposed."],
[&"", &"HELP_RESOURCES_ACTION"]: [&"Recruit workers in the Army tab. Watch their carried logs and the shared resource totals."],
[&"", &"HELP_TOWERS_TITLE"]: [&"Build pads and Guard Towers"],
[&"", &"HELP_TOWERS_BODY"]: [&"Approach a build pad to choose Guard, Splash or Long-range. Guard is reliable; Splash hits clustered troops; Long-range is powerful but cannot fire at nearby enemies. Each costs gold and wood.\nUpgrade friendly towers to level 3. Enemy home pads are protected; destroyed towers leave a brief rebuild cooldown."],
[&"", &"HELP_TOWERS_ACTION"]: [&"Use towers to support a route or protect workers near a grove."],
[&"", &"HELP_UPGRADES_TITLE"]: [&"Strengthen your team"],
[&"", &"HELP_UPGRADES_BODY"]: [&"The King tab improves your King's health, damage, attack speed and range. The Economy tab improves worker movement, loads, gathering and passive gold income.\nSpend wood from anywhere on the battlefield. Each card shows the current value, the next value and its cost. Upgrades are shared by your team and apply immediately."],
[&"", &"HELP_UPGRADES_ACTION"]: [&"Balance recruitment, defenses and upgrades. Keep an eye on both King health bars."],
[&"", &"HELP_MAP_TITLE"]: [&"Read the battlefield"],
[&"", &"HELP_MAP_BODY"]: [&"Crowns mark Kings. Diamonds mark Azure commanders; downward triangles mark Ember commanders. The white ring marks you. Smaller army marks merge into groups.\nSquares are towers; plus signs are empty pads. The bright road is your selected route and the white rectangle is your view. A ring around a King warns of danger."],
[&"", &"HELP_MAP_ACTION"]: [&"Use the minimap to spot exposed routes and return when your King needs help."],
[&"", &"HELP_TIP_OBJECTIVE"]: [&"Protect your King. Destroy the enemy King to win. Commanders respawn; Kings do not."],
[&"", &"HELP_TIP_MOVE"]: [&"WASD moves your commander. Hold SPACE to attack. The white ring marks you."],
[&"", &"HELP_TIP_MOVE_TOUCH"]: [&"Drag left to move; attacks are automatic. Aim dash, guard and heavy strike with the right buttons."],
[&"", &"HELP_TIP_RECRUIT"]: [&"Choose North, Center or South, then recruit. New troops follow that route automatically."],
[&"", &"HELP_TIP_WORKERS"]: [&"Workers deliver wood and gold. Your resources and upgrades are shared with your ally."],
[&"", &"HELP_TIP_PADS"]: [&"Stand by a build pad and press E. Build a Guard Tower and upgrade it up to level 3."],
[&"", &"HELP_TIP_UPGRADES"]: [&"Spend wood in the King and Economy tabs. Press E near your King to heal when supplies are ready."],
[&"", &"HELP_TIP_MAP"]: [&"Check the minimap for Kings, commanders and army groups. The white ring marks you."],
[&"", &"HELP_TIP_RESPAWN"]: [&"Your commander will return at the base. You can still recruit and buy upgrades while waiting."],
[&"", &"STATUS_ESCORTING"]: [&"Escorting you"],
[&"", &"COMMAND_TITLE"]: [&"ALLY COMMAND"],
