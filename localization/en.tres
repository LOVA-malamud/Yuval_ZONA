[&"", &"DIFFICULTY_HARD"]: [&"Next match: Hard"],
[&"", &"DIFFICULTY_TOOLTIP"]: [&"Changes AI decisions and coordination for the next match. Resources and unit stats remain equal."],
[&"", &"RECAP_COMMANDER"]: [&"%s · spent %d gold / %d wood · recruits %d · King damage %.0f · rallies %d"],
[&"", &"RECAP_TEAM"]: [&"Your team · workers lost %d · wood delivered %d · towers built %d / lost %d"],
[&"", &"TUTORIAL_BUTTON"]: [&"Play tutorial"],
[&"", &"MATCH_BUTTON"]: [&"New standard match"],
[&"", &"TUTORIAL_MOVE"]: [&"Move toward the marked practice enemy: WASD, or drag on the left. Travel a short distance to begin."],
[&"", &"TUTORIAL_ATTACK"]: [&"Defeat the practice enemy. Hold Space nearby; touch attacks automatically. Aim heavy strike carefully: its narrow hit briefly stuns."],
[&"", &"TUTORIAL_RECRUIT"]: [&"Choose a route with 1/2/3 or the selector, then recruit a troop in Army. New recruits start at your King."],
[&"", &"TUTORIAL_COORDINATE"]: [&"Open Orders and give your ally an order. Stand near your recruited troop and use Rally (Q or the button)."],
[&"", &"TUTORIAL_TOWER"]: [&"Go to the marked home build pad. Press E or Interact, then build a Guard Tower with shared gold and wood."],
[&"", &"TUTORIAL_KING"]: [&"Follow a lane to the opposing King and destroy it. This training King cannot attack. King destruction wins the match."],
[&"", &"TUTORIAL_COMPLETE"]: [&"Tutorial complete. You can command your ally, rally troops, recruit by lane, build defenses, and win by destroying the King."],
[&"", &"ALERT_TOWER_LOST"]: [&"%s: Guard Tower lost"],
[&"", &"ALERT_WORKERS_THREATENED"]: [&"%s: Workers under attack"],
[&"", &"ALERT_KING_DANGER"]: [&"%s: King in danger"],
[&"", &"ALERT_PUSH_FORMING"]: [&"%s: Allied push forming"],
[&"", &"MAP_RENEWABLE"]: [&"Finite timber · secure exposed groves"],
[&"", &"MAP_NEUTRAL_PAD"]: [&"Neutral tower pad · hold the approach"],
[&"", &"TUTORIAL_SKIP"]: [&"Skip tutorial"],
[&"", &"HELP_COORDINATION_TITLE"]: [&"Command the local battle"],
[&"", &"HELP_COORDINATION_BODY"]: [&"Orders tells your ally to push a lane, defend, escort you, or act automatically. Emergencies take priority. Its plans and recent shared spending are visible.\nQ Rally buffs allied troops within 300 for 8 seconds (+15% speed, +20% attack rate); cooldown 30 seconds. R Regroup gathers troops within 400 for 8 seconds; nearby combat takes priority."],
[&"", &"HELP_COORDINATION_ACTION"]: [&"Click an enemy to focus attacks; hold Space to strike. Use 1/2/3 for new recruits. Start the playable tutorial from Pause."],
[&"", &"ABILITY_DASH"]: [&"Dash"],
